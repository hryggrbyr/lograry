---
const title = "Admin";
import { getCollection } from "astro:content";
import Header from "./header.astro";
import MediaForm from "./MediaForm.astro";

const book = await getCollection("books");
const movie = await getCollection("movies");
const series = await getCollection("series");

const formatYear = (dateStr) => {
  if (!dateStr) return "—";
  return String(dateStr).match(/\d{4}/)?.[0] || dateStr;
};

const processItemData = (item) => {
  const data = item.data;
  const creatorField = data.author || data.director;
  const creator = Array.isArray(creatorField)
    ? creatorField.join(", ")
    : creatorField || "—";
  const year = formatYear(data.published || data.year);
  const safeData = JSON.stringify({ ...data, body: item.body }).replace(
    /'/g,
    "&apos;",
  );
  return { creator, year, safeData };
};

const collections = { book, movie, series };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root {
        --color-brand-admin: hsl(25, 95%, 55%);
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        padding: 2rem;
        max-width: 80rem;
        margin-inline: auto;
        font-family: system-ui, sans-serif;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
        table-layout: fixed;
      }
      th,
      td {
        text-align: left;
        padding: 0.75rem;
        border-bottom: 1px solid #eee;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      th {
        background: #f9f9f9;
        font-size: 0.8rem;
        text-transform: uppercase;
        color: #666;
      }
      tbody tr {
        cursor: pointer;
      }
      tbody tr:hover {
        background-color: #fff4ed;
      }
      [data-table-section] {
        display: none;
      }
      body[data-selection="book"] [data-table-section="book"],
      body[data-selection="movie"] [data-table-section="movie"],
      body[data-selection="series"] [data-table-section="series"] {
        display: block;
      }
      dialog {
        width: 95%;
        max-width: 75rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 2rem;
      }
      .flow > * + * {
        margin-block-start: 1.5rem;
      }
    </style>
  </head>
  <body class="flow" data-selection="book">
    <header
      style="display:flex; justify-content: space-between; align-items:center;"
    >
      <h1>Archive</h1>
      <Header />
    </header>

    <select id="media-type-filter" style="width: auto; padding: 0.5rem;">
      <option value="book">BOOKS</option>
      <option value="movie">FILMS</option>
      <option value="series">TV SHOWS</option>
    </select>

    {
      Object.entries(collections).map(([type, items]) => (
        <section data-table-section={type}>
          <table>
            <thead>
              <tr>
                <>
                  <th>Title</th>
                  <th>Creator</th>
                  <th>Year</th>
                  <th>Status</th>
                </>
              </tr>
            </thead>
            <tbody>
              {items.map((item) => {
                const { creator, year, safeData } = processItemData(item);
                return (
                  <tr
                    onclick={`openEditPanel('${type}', JSON.parse(this.dataset.itemData))`}
                    data-item-data={safeData}
                  >
                    <td>{item.data.title}</td>
                    <td>{creator}</td>
                    <td>{year}</td>
                    <td>{item.data.shelf}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </section>
      ))
    }

    <dialog id="edit-panel">
      <MediaForm title="Edit Entry" />
      <button
        onclick="document.getElementById('edit-panel').close()"
        style="margin-top:1rem; background:#666">CANCEL</button
      >
    </dialog>

    <script>
      import { generateFilename, pushToGitHub } from "@lib/pushToGithub";

      // Filter Logic
      const filter = document.getElementById(
        "media-type-filter",
      ) as HTMLSelectElement;
      filter.onchange = () =>
        document.body.setAttribute("data-selection", filter.value);

      // Edit Panel Logic
      window.openEditPanel = (type, data) => {
        const componentType =
          type === "book" ? "books" : type === "movie" ? "movies" : "series";
        const wrapper = document.getElementById("media-form-context");

        wrapper.setAttribute("data-selection", componentType);
        (document.getElementById("field-type") as HTMLInputElement).value =
          componentType;
        document.dispatchEvent(new CustomEvent("form-type-change"));

        // Populate Common
        (document.getElementById("field-title") as HTMLInputElement).value =
          data.title || "";
        (document.getElementById("field-created") as HTMLInputElement).value =
          data.created || "";
        (document.getElementById("field-rating") as HTMLInputElement).value =
          data.rating || 0;
        (document.getElementById("field-body") as HTMLTextAreaElement).value =
          data.body || "";
        document
          .getElementById("field-shelf")
          .setAttribute("data-initial-value", data.shelf || "");

        const toCsv = (val) =>
          Array.isArray(val) ? val.join(", ") : val || "";

        // Populate Type Specific
        if (componentType === "books") {
          (document.getElementById("field-author") as HTMLInputElement).value =
            toCsv(data.author);
          (document.getElementById("field-tags") as HTMLInputElement).value =
            toCsv(data.tags);
          (
            document.getElementById("field-start_date") as HTMLInputElement
          ).value = data.start_date || "";
          (
            document.getElementById("field-end_date") as HTMLInputElement
          ).value = data.end_date || "";
          (
            document.getElementById("field-publisher") as HTMLInputElement
          ).value = data.publisher || "";
          (
            document.getElementById("field-published") as HTMLInputElement
          ).value = data.published || "";
          (
            document.getElementById("field-page_count") as HTMLInputElement
          ).value = data.page_count || "";
          (document.getElementById("field-isbn") as HTMLInputElement).value =
            data.isbn || "";
          (
            document.getElementById("field-coverUrl") as HTMLInputElement
          ).value = data.coverUrl || "";
        } else if (componentType === "movies") {
          (
            document.getElementById("field-director") as HTMLInputElement
          ).value = data.director || "";
          (document.getElementById("field-year") as HTMLInputElement).value =
            data.year || "";
          (document.getElementById("field-country") as HTMLInputElement).value =
            data.country || "";
          (document.getElementById("field-watched") as HTMLInputElement).value =
            data.watched || "";
          (document.getElementById("field-length") as HTMLInputElement).value =
            data.length || "";
          (document.getElementById("field-genre") as HTMLInputElement).value =
            toCsv(data.genre);
          (document.getElementById("field-actors") as HTMLInputElement).value =
            toCsv(data.actors);
          (document.getElementById("field-poster") as HTMLInputElement).value =
            data.poster || "";
        } else if (componentType === "series") {
          (
            document.getElementById("field-director-series") as HTMLInputElement
          ).value = data.director || "";
          (
            document.getElementById("field-year-series") as HTMLInputElement
          ).value = data.year || "";
          (
            document.getElementById("field-country-series") as HTMLInputElement
          ).value = data.country || "";
          (
            document.getElementById("field-watched-series") as HTMLInputElement
          ).value = data.watched || "";
          (
            document.getElementById("field-length-series") as HTMLInputElement
          ).value = data.length || "";
          (
            document.getElementById("field-genre-series") as HTMLInputElement
          ).value = toCsv(data.genre);
          (
            document.getElementById("field-actors-series") as HTMLInputElement
          ).value = toCsv(data.actors);
          (
            document.getElementById("field-poster-series") as HTMLInputElement
          ).value = data.poster || "";
        }

        (
          document.getElementById("edit-panel") as HTMLDialogElement
        ).showModal();
      };

      // Submit logic
      document.getElementById("entry-form").onsubmit = async (e) => {
        e.preventDefault();
        const btn = document.getElementById(
          "btn-submit-github",
        ) as HTMLButtonElement;
        btn.disabled = true;
        btn.innerText = "UPDATING...";

        const formData = new FormData(e.target as HTMLFormElement);
        const type = formData.get("type") as string;
        const fromCsv = (name) =>
          formData
            .get(name)
            .toString()
            .split(",")
            .map((s) => s.trim())
            .filter(Boolean);

        const entryData: any = {
          type,
          title: formData.get("title"),
          created: formData.get("created"),
          shelf: formData.get("shelf"),
          rating: parseInt(formData.get("rating") as string) || 0,
        };

        if (type === "books") {
          Object.assign(entryData, {
            author: fromCsv("author"),
            tags: fromCsv("tags"),
            start_date: formData.get("start_date") || null,
            end_date: formData.get("end_date") || null,
            published: formData.get("published") || null,
            publisher: formData.get("publisher") || null,
            page_count: parseInt(formData.get("page_count") as string) || null,
            isbn: formData.get("isbn") || null,
            coverUrl: formData.get("coverUrl") || null,
          });
        } else if (type === "movies") {
          Object.assign(entryData, {
            director: formData.get("director"),
            year: formData.get("year"),
            country: formData.get("country"),
            watched: formData.get("watched"),
            length: formData.get("length") || null,
            genre: fromCsv("genre"),
            actors: fromCsv("actors"),
            poster: formData.get("poster") || null,
          });
        } else if (type === "series") {
          Object.assign(entryData, {
            director: formData.get("director_series"),
            year: formData.get("year_series"),
            country: formData.get("country_series"),
            watched: formData.get("watched_series"),
            length: formData.get("length_series") || null,
            genre: fromCsv("genre_series"),
            actors: fromCsv("actors_series"),
            poster: formData.get("poster_series") || null,
          });
        }

        try {
          const fileName = generateFilename(entryData, type);
          await pushToGitHub(
            `src/content/${type}`,
            fileName,
            entryData,
            formData.get("body") as string,
          );
          location.reload();
        } catch (err) {
          alert(err);
          btn.disabled = false;
        }
      };
    </script>
  </body>
</html>
