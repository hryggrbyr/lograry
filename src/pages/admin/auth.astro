<dialog id="auth-dialog">
  <div class="index-card auth-modal flow">
    <h2>[RESTRICTED_ACCESS]</h2>
    <p>
      No GitHub credentials found in local storage. Please provide authorization
      to access the archives.
    </p>
    <div class="field">
      <label>[GH_USER]</label>
      <input
        type="text"
        id="modal-gh-user"
        class="biro-input"
        placeholder="Username"
      />
    </div>
    <div class="field">
      <label>[GH_TOKEN]</label>
      <input
        type="text"
        id="modal-gh-pat"
        class="biro-input"
        placeholder="ghp_xxxx..."
      />
    </div>
    <button id="btn-auth-confirm" class="btn-stamped">INITIALIZE_SESSION</button
    >
  </div>
</dialog>

<script is:inline>
  const authDialog = document.getElementById("auth-dialog");
  const adminContent = document.getElementById("admin-content");
  // Check for credentials immediately
  function checkAuth() {
    const user = localStorage.getItem("LOGRARY_USER");
    const pat = localStorage.getItem("LOGRARY_PAT");
    if (!user || !pat) {
      authDialog.showModal();
    } else {
      window.document.documentElement.style.backgroundColor = "red";
    }
  }
</script>
