---
const title = "New Archive Entry";
import Header from "./header.astro";
import MediaForm from "./MediaForm.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root {
        --color-brand-admin: hsl(25, 95%, 55%);
        --color-brand-admin-tint: hsl(25, 95%, 50%);
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        padding: 2rem;
        max-width: 80rem;
        margin-inline: auto;
        font-family: system-ui, sans-serif;
      }
      input,
      select,
      textarea,
      button {
        font: inherit;
        width: 100%;
      }
      button {
        appearance: none;
        background-color: var(--color-brand-admin);
        color: white;
        cursor: pointer;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 0.25rem;
        width: auto;
        font-weight: bold;
      }
      button:hover {
        background-color: var(--color-brand-admin-tint);
      }
      button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
      .stacker {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        align-items: center;
      }
      .prominent-tools {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        align-items: flex-start;
      }
      .prominent-tools > * {
        flex: 1;
        min-width: 300px;
      }
      label {
        display: block;
        margin-bottom: 0.35rem;
        font-weight: 500;
        font-size: 0.9rem;
      }
      .flow > * + * {
        margin-block-start: 1.5rem;
      }
      hr {
        border: none;
        border-top: 1px solid #eee;
        margin: 2rem 0;
      }
    </style>
  </head>
  <body class="flow">
    <div class="admin-container flow">
      <header class="stacker">
        <h1>{title}</h1>
        <div style="display: flex; justify-content: flex-end; gap: 1rem;">
          <Header />
          <button id="btn-logout">SIGN_OUT</button>
        </div>
      </header>

      <section class="prominent-tools">
        <div>
          <label for="media-type">Collection Type</label>
          <select id="media-type">
            <option value="books">📚 BOOKS</option>
            <option value="movies">🎬 FILMS</option>
            <option value="series">📺 TV SHOWS</option>
          </select>
        </div>
      </section>

      <hr />
      <MediaForm />
    </div>

    <script>
      import { generateFilename, pushToGitHub } from "@lib/pushToGithub";

      const mediaSelector = document.getElementById(
        "media-type",
      ) as HTMLSelectElement;
      const entryForm = document.getElementById(
        "entry-form",
      ) as HTMLFormElement;

      // Handle Logout
      document.getElementById("btn-logout").onclick = () => {
        localStorage.clear();
        location.reload();
      };

      // Type Switcher Logic
      mediaSelector.onchange = () => {
        const type = mediaSelector.value;
        const wrapper = document.getElementById("media-form-context");
        const typeHiddenInput = document.getElementById(
          "field-type",
        ) as HTMLInputElement;

        wrapper.setAttribute("data-selection", type);
        typeHiddenInput.value = type;

        // Notify MediaForm to update its internal Enum options
        document.dispatchEvent(new CustomEvent("form-type-change"));
      };

      // Form Submission
      entryForm.onsubmit = async (e) => {
        e.preventDefault();
        const btn = document.getElementById(
          "btn-submit-github",
        ) as HTMLButtonElement;
        btn.disabled = true;
        btn.innerText = "COMMITTING...";

        const formData = new FormData(entryForm);
        const type = formData.get("type") as string;
        const fromCsv = (name: string) =>
          formData
            .get(name)
            ?.toString()
            .split(",")
            .map((s) => s.trim())
            .filter(Boolean) || [];

        const entryData: any = {
          type: type,
          title: formData.get("title"),
          created: formData.get("created"),
          shelf: formData.get("shelf"),
          rating: parseInt(formData.get("rating") as string) || 0,
        };

        if (type === "books") {
          Object.assign(entryData, {
            author: fromCsv("author"),
            tags: fromCsv("tags"),
            start_date: formData.get("start_date") || null,
            end_date: formData.get("end_date") || null,
            published: formData.get("published") || null,
            publisher: formData.get("publisher") || null,
            page_count: parseInt(formData.get("page_count") as string) || null,
            isbn: formData.get("isbn") || null,
            coverUrl: formData.get("coverUrl") || null,
          });
        } else if (type === "movies") {
          Object.assign(entryData, {
            director: formData.get("director"),
            year: formData.get("year"),
            country: formData.get("country"),
            watched: formData.get("watched"),
            length: formData.get("length") || null,
            genre: fromCsv("genre"),
            actors: fromCsv("actors"),
            poster: formData.get("poster") || null,
          });
        } else if (type === "series") {
          Object.assign(entryData, {
            director: formData.get("director_series"),
            year: formData.get("year_series"),
            country: formData.get("country_series"),
            watched: formData.get("watched_series"),
            length: formData.get("length_series") || null,
            genre: fromCsv("genre_series"),
            actors: fromCsv("actors_series"),
            poster: formData.get("poster_series") || null,
          });
        }

        try {
          const fileName = generateFilename(entryData, type);
          await pushToGitHub(
            `src/content/${type}`,
            fileName,
            entryData,
            formData.get("body") as string,
          );
          location.href = "/";
        } catch (err) {
          alert("Error: " + err);
          btn.disabled = false;
          btn.innerText = "RETRY_COMMIT";
        }
      };
    </script>
  </body>
</html>
