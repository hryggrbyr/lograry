---
/* src/pages/admin.astro */
const BASE_URL = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Lograry Admin | Quick Capture</title>
    <link rel="manifest" href={`${BASE_URL}manifest.json`} />
    <link
      href={`${BASE_URL}admin/config.yml`}
      type="text/yaml"
      rel="shortcut config"
    />
    <style>
      #quick-capture {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 9999;
        background: #1a1a1a;
        color: #eee;
        padding: 10px 20px;
        display: none;
        gap: 10px;
        align-items: center;
        border-bottom: 1px solid #333;
        font-family: system-ui, sans-serif;
      }
      #quick-capture.show {
        display: flex;
      }
      input {
        background: #000;
        border: 1px solid #444;
        color: #fff;
        padding: 6px 12px;
        border-radius: 4px;
        flex-grow: 1;
      }
      button {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 6px 15px;
        border-radius: 4px;
        cursor: pointer;
        font-weight: bold;
      }
      button:hover {
        background: #2563eb;
      }
      #status {
        font-size: 0.8rem;
        min-width: 150px;
      }
      .confirmation-overlay {
        border: 2px solid #3a86ff;
        padding: 1rem;
        background: #fff;
        border-radius: 8px;
        margin: 10px 0;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        position: fixed;
        bottom: 80px;
        left: 20px;
        right: 20px;
        max-width: 400px;
        z-index: 9998;
        color: #000;
        display: none;
      }
      .confirmation-overlay.show {
        display: block;
      }
      .preview-card {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
      }
      .preview-card img {
        max-width: 50px;
        height: auto;
      }
      .btn-confirm {
        background: #3a86ff;
        color: white;
        border: none;
        padding: 5px 10px;
        cursor: pointer;
        margin-right: 10px;
      }
      .btn-confirm:hover {
        background: #2563eb;
      }
      .btn-cancel {
        background: #666;
        color: white;
        border: none;
        padding: 5px 10px;
        cursor: pointer;
      }
      .btn-cancel:hover {
        background: #555;
      }
    </style>
  </head>
  <body>
    <div id="quick-capture">
      <span>🚀</span>
      <span>
        <input
          type="text"
          id="query"
          placeholder="Search Title, Author, or ISBN..."
        />
        <div id="status">Ready</div>
      </span>
      <button id="search-btn">Search & Copy</button>
    </div>

    <div id="book-preview-overlay" class="confirmation-overlay">
      <p><strong>Is this correct?</strong></p>
      <div class="preview-card" id="preview-card-content">
        <img id="preview-cover" src="" alt="cover" width="50" />
        <span id="preview-title-author"></span>
      </div>
      <button id="btn-confirm" class="btn-confirm">
        ✅ Yes, Fill Fields
      </button>
      <button id="btn-cancel" class="btn-cancel"> ❌ No, Clear </button>
    </div>

    <script is:inline src="https://unpkg.com/js-yaml@4.1.0/dist/js-yaml.js"
    ></script>

    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/@sveltia/cms@latest/dist/sveltia-cms.js"
    ></script>

    <script is:inline define:vars={{ BASE_URL }}>
      // Register preview style after CMS loads
      if (typeof CMS !== "undefined") {
        try {
          CMS.registerPreviewStyle(`${BASE_URL}admin/preview.css`);
        } catch (e) {
          console.warn("Failed to register preview style:", e);
        }
      }
    </script>

    <script is:inline define:vars={{ BASE_URL }}>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register(`${BASE_URL}sw.js`).then(
            (registration) => {
              console.log(
                "ServiceWorker registration successful with scope: ",
                registration.scope,
              );
            },
            (err) => {
              console.log("ServiceWorker registration failed: ", err);
            },
          );
        });
      }
    </script>

    <script is:inline>
      let bookPreview = null;
      let yamlString = "";

      function showBookPreview(bookData) {
        bookPreview = bookData;
        const hiddenTypeInput = document.querySelector(
          'input[type="hidden"][name="type"]',
        );
        const capturedType = hiddenTypeInput?.value?.trim();
        const entries = Object.entries(bookData);
        if (capturedType) {
          entries.unshift(["type", capturedType]);
        }
        yamlString = entries
          .map(([key, val]) => `${key}: ${JSON.stringify(val)}`)
          .join("\n");

        document.getElementById("preview-cover").src = bookData.coverUrl || "";
        const meta =
          bookData.type === "book"
            ? `by ${(bookData.author || []).join(", ")}`
            : `Directed by ${
                (bookData.directors && bookData.directors.length
                  ? bookData.directors
                  : (bookData.director || "")
                      .split(",")
                      .map((s) => s.trim())
                      .filter(Boolean)
                ).join(", ") || "Unknown"
              }`;
        document.getElementById("preview-title-author").textContent =
          `${bookData.title} — ${meta}`;
        document.getElementById("book-preview-overlay").classList.add("show");
      }

      function hideBookPreview() {
        bookPreview = null;
        yamlString = "";
        document
          .getElementById("book-preview-overlay")
          .classList.remove("show");
      }

      async function applyToFields() {
        const logOutput = [];
        const pushLog = (msg) => {
          try {
            logOutput.push(`[${new Date().toISOString()}] ${msg}`);
          } catch (_) {
            // ignore logging errors
          }
        };

        try {
          const data = jsyaml.load(yamlString);
          pushLog("YAML Data being applied: " + JSON.stringify(data));
          pushLog("YAML String: " + yamlString);

          const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

          const waitFor = async (selector, timeout = 7000, interval = 150) => {
            const start = Date.now();
            while (Date.now() - start < timeout) {
              const el = document.querySelector(selector);
              if (el) return el;
              await sleep(interval);
            }
            return null;
          };

          const ensureFieldRendered = async (key) => {
            let section = document.querySelector(
              `section[data-key-path="${key}"]`,
            );
            if (section) {
              pushLog(`Field "${key}" already in DOM`);
              return section;
            }

            const container =
              document.querySelector("#first-pane-body .content") ||
              document.querySelector(
                '[data-mode="edit"] #first-pane-body .content',
              ) ||
              document.querySelector('[data-mode="edit"]');

            if (!container) {
              pushLog("Editor container not found");
              return null;
            }

            // Start from top
            container.scrollTop = 0;
            const step = Math.max(1, Math.floor(container.clientHeight * 0.5));
            const maxSteps = 40;

            // Scroll downward slowly
            for (let i = 0; i < maxSteps; i++) {
              section = document.querySelector(
                `section[data-key-path="${key}"]`,
              );
              if (section) {
                pushLog(
                  `Field "${key}" found while scrolling down at step ${i}`,
                );
                return section;
              }
              container.scrollTop = Math.min(
                container.scrollTop + step,
                container.scrollHeight,
              );
              pushLog(
                `Scroll down step ${i}, scrollTop=${container.scrollTop}, scrollHeight=${container.scrollHeight}`,
              );
              await sleep(250);
            }

            // Scroll back to top (in case virtualization needs a reset)
            container.scrollTop = 0;
            await sleep(200);

            // One more slower pass
            for (let i = 0; i < maxSteps; i++) {
              section = document.querySelector(
                `section[data-key-path="${key}"]`,
              );
              if (section) {
                pushLog(`Field "${key}" found during second pass at step ${i}`);
                return section;
              }
              container.scrollTop = Math.min(
                container.scrollTop + Math.floor(step / 2),
                container.scrollHeight,
              );
              pushLog(
                `Second pass step ${i}, scrollTop=${container.scrollTop}`,
              );
              await sleep(300);
            }

            pushLog(`Field "${key}" NOT found after scrolling`);
            return null;
          };

          const normalizeDate = (value) => {
            if (!value) return "";
            if (/^\d{4}$/.test(value)) return `${value}-01-01`;
            if (/^\d{4}-\d{2}$/.test(value)) return `${value}-01`;
            return value;
          };

          // Ensure the editor is ready
          const editorReady = await waitFor(
            'section[data-key-path="title"]',
            7000,
          );
          if (!editorReady) {
            pushLog("Editor fields did not mount within timeout");
          } else {
            pushLog("Editor ready: title field present");
          }

          // Populate sequentially so virtualization/scroll can render fields
          for (const [key, raw] of Object.entries(data)) {
            const value = key === "published" ? normalizeDate(raw) : raw;
            pushLog(
              `Processing key="${key}" with value=${JSON.stringify(value)}`,
            );

            const fieldSection = await ensureFieldRendered(key);
            if (!fieldSection) {
              pushLog(`Field "${key}" not present after retries; skipping`);
              continue;
            }

            const fieldType = fieldSection.getAttribute("data-field-type");
            pushLog(`Field "${key}" type="${fieldType}"`);
            let input = null;

            if (fieldType === "string") {
              input = fieldSection.querySelector("input[type='text']");
            } else if (fieldType === "number") {
              // Try common Sveltia number patterns
              input =
                fieldSection.querySelector(
                  "input[type='text'][inputmode='numeric']",
                ) ||
                fieldSection.querySelector("input[role='spinbutton']") ||
                fieldSection.querySelector("input[type='number']") ||
                fieldSection.querySelector("input[type='text']");
            } else if (fieldType === "list") {
              input = fieldSection.querySelector("textarea");
            } else if (fieldType === "boolean") {
              const switchButton = fieldSection.querySelector(
                "button[role='switch']",
              );
              if (switchButton && value) {
                switchButton.click();
                pushLog(`Toggled boolean for "${key}"`);
              } else {
                pushLog(
                  `Boolean "${key}" not toggled (value=${JSON.stringify(value)})`,
                );
              }
              continue;
            } else if (fieldType === "select") {
              // Handle radio-group and combobox variants
              const radioGroup = fieldSection.querySelector(
                "[role='radiogroup']",
              );
              if (radioGroup && value) {
                const btn = radioGroup.querySelector(
                  `button[data-value="${value}"]`,
                );
                if (btn) {
                  btn.click();
                  pushLog(`Selected radiogroup option "${value}" for "${key}"`);
                } else {
                  pushLog(
                    `Radiogroup option not found for "${key}" value="${value}"`,
                  );
                }
              } else {
                const combobox =
                  fieldSection.querySelector("[role='combobox']");
                if (combobox && value) {
                  combobox.click();
                  pushLog(`Opened combobox for "${key}"`);
                  await sleep(150);
                  const options = document.querySelectorAll("[role='option']");
                  let selected = false;
                  for (const option of options) {
                    if (option.textContent.trim() === String(value)) {
                      option.click();
                      selected = true;
                      pushLog(
                        `Selected combobox option "${value}" for "${key}"`,
                      );
                      break;
                    }
                  }
                  if (!selected) {
                    pushLog(
                      `Combobox option not found for "${key}" value="${value}"`,
                    );
                  }
                } else {
                  pushLog(`No combobox present for "${key}" or empty value`);
                }
              }
              continue;
            } else if (fieldType === "datetime") {
              input = fieldSection.querySelector("input[type='date']");
            }

            if (!input) {
              pushLog(`No input element resolved for "${key}"`);
              continue;
            }

            if (Array.isArray(value)) {
              input.value = value.join("\n");
            } else if (value !== null && value !== undefined) {
              input.value = value;
            } else {
              input.value = "";
            }
            pushLog(`Set value for "${key}" to ${JSON.stringify(input.value)}`);

            input.dispatchEvent(new Event("input", { bubbles: true }));
            input.dispatchEvent(new Event("change", { bubbles: true }));
            input.dispatchEvent(new Event("blur", { bubbles: true }));
            pushLog(`Dispatched input/change/blur for "${key}"`);
          }

          setTimeout(() => {
            hideBookPreview();
          }, 300);
        } catch (e) {
          pushLog("Error in applyToFields: " + e.message);
          console.error("Failed to populate fields", e);
          alert("Failed to populate fields: " + e.message);
        }
      }

      document.getElementById("btn-confirm").onclick = applyToFields;
      document.getElementById("btn-cancel").onclick = hideBookPreview;

      // Show/hide quick-capture based on route
      function updateQuickCaptureVisibility() {
        const hash = window.location.hash;
        const quickCapture = document.getElementById("quick-capture");
        const bookPreviewOverlay = document.getElementById(
          "book-preview-overlay",
        );

        // Only show on new page
        if (hash.includes("/new")) {
          quickCapture.classList.add("show");
        } else {
          quickCapture.classList.remove("show");
          // Hide preview overlay if navigating away
          bookPreviewOverlay.classList.remove("show");
        }
      }

      // Check visibility on load and when hash changes
      updateQuickCaptureVisibility();
      window.addEventListener("hashchange", updateQuickCaptureVisibility);

      // Pre-populate hidden type input from existing editor field (when editing)
      (async () => {
        const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
        const waitFor = async (selector, timeout = 7000, interval = 150) => {
          const start = Date.now();
          while (Date.now() - start < timeout) {
            const el = document.querySelector(selector);
            if (el) return el;
            await sleep(interval);
          }
          return null;
        };

        const typeSection = await waitFor(
          'section[data-key-path="type"]',
          5000,
        );
        const hiddenTypeInput = document.querySelector(
          'input[type="hidden"][name="type"]',
        );

        if (typeSection && hiddenTypeInput) {
          const fieldType = typeSection.getAttribute("data-field-type");

          if (fieldType === "string") {
            const input =
              typeSection.querySelector("input[type='text']") ||
              typeSection.querySelector("input");
            if (input && input.value) {
              hiddenTypeInput.value = input.value.trim();
            }
          } else if (fieldType === "select") {
            const activeRadio = typeSection.querySelector(
              '[role="radiogroup"] button[aria-checked="true"]',
            );
            if (activeRadio && activeRadio.dataset.value) {
              hiddenTypeInput.value = activeRadio.dataset.value.trim();
            } else {
              // Fallback to combobox label text if present
              const comboboxLabel =
                typeSection.querySelector('[role="combobox"]');
              if (comboboxLabel && comboboxLabel.textContent) {
                hiddenTypeInput.value = comboboxLabel.textContent.trim();
              }
            }
          }
        }
      })();

      // Helpers for enriched movie fetch via IMDb mirror
      async function getFullMovieData(title) {
        try {
          // STEP 1: Search to get the IMDb ID
          const searchRes = await fetch(
            `https://imdb.iamidiotareyoutoo.com/search?q=${encodeURIComponent(title)}`,
          );
          const searchData = await searchRes.json();

          if (!searchData.description || searchData.description.length === 0)
            return null;

          const basicInfo = searchData.description[0];
          const imdbId = basicInfo["#IMDB_ID"];
          if (!imdbId) return null;

          // STEP 2: Fetch detailed info (Director, Runtime, Genres) via JSON-LD-like shape
          const detailRes = await fetch(
            `https://imdb.iamidiotareyoutoo.com/main?id=${imdbId}`,
          );
          const details = await detailRes.json();

          // STEP 3: Map to your specific fields
          const short = details?.short || {};
          const actorsFromShort = Array.isArray(short.actor)
            ? short.actor.map((a) => a?.name).filter(Boolean)
            : [];
          const actorsFromBasic = basicInfo["#ACTORS"]
            ? basicInfo["#ACTORS"].split(", ").map((s) => s.trim())
            : [];

          return {
            type: "movie",
            title: short.name || basicInfo["#TITLE"] || title,
            country: short?.countryOfOrigin?.[0]?.name || "",
            year: parseInt(basicInfo["#YEAR"]) || "",
            director:
              Array.isArray(short?.director) && short.director.length
                ? short.director
                    .map((d) => d?.name)
                    .filter(Boolean)
                    .join(", ")
                : "Unknown",
            actors: actorsFromShort.length ? actorsFromShort : actorsFromBasic,
            genre: Array.isArray(short?.genre) ? short.genre : [],
            length: short?.duration ? formatDuration(short.duration) : "",
            shelf: "to-watch",
            owned: false,
            rating: 0,
            watched: "",
            poster: short?.image || basicInfo["#IMG_POSTER"] || "",
            body:
              short?.description ||
              (basicInfo["#RANK"] ? `IMDb Rank: ${basicInfo["#RANK"]}` : ""),
          };
        } catch (error) {
          console.error("Fetch failed:", error);
          return null;
        }
      }

      // Helper to convert ISO 8601 duration (PT1H48M) to readable string (1h 48m)
      function formatDuration(iso) {
        if (!iso || typeof iso !== "string") return "";
        return iso
          .replace(/^PT/, "")
          .replace(/H/, "h ")
          .replace(/M/, "m")
          .trim()
          .toLowerCase();
      }

      document.getElementById("search-btn").onclick = async () => {
        const query = document.getElementById("query").value;
        const status = document.getElementById("status");
        if (!query) return;

        const hash = window.location.hash || "";
        const isBook = hash.includes("/books/new");
        const isMovie = hash.includes("/movies/new");
        const isSeries = hash.includes("/series/new");

        try {
          if (isBook) {
            status.innerText = "Searching Open Library...";
            const searchUrl = `https://openlibrary.org/search.json?q=${encodeURIComponent(query)}&limit=1`;
            const response = await fetch(searchUrl);
            const data = await response.json();

            if (data.docs && data.docs.length > 0) {
              const book = data.docs[0];
              const capture = {
                type: "book",
                title: book.title,
                subtitle: book.subtitle || "",
                author: book.author_name || [],
                published: book.first_publish_year?.toString() || "",
                publisher: book.publisher?.[0] || "",
                page_count: book.number_of_pages_median || null,
                isbn: book.isbn?.[0] || "",
                coverUrl: book.cover_i
                  ? `https://covers.openlibrary.org/b/id/${book.cover_i}-L.jpg`
                  : "",
                shelf: "to-read",
                owned: false,
                rating: 0,
                body: "",
              };
              showBookPreview(capture);
              status.innerText = "✓ Book found! Confirm above.";
            } else {
              status.innerText = "❌ No book results found.";
            }
          } else if (isMovie) {
            status.innerText = "Searching IMDb (mirror)...";
            const searchUrl = `https://imdb.iamidiotareyoutoo.com/search?q=${encodeURIComponent(query)}`;
            const response = await fetch(searchUrl);
            const data = await response.json();

            if (data.description && data.description.length > 0) {
              const movie = data.description[0];

              // Attempt to resolve an IMDb ID for a second, details fetch
              const imdbId =
                movie["#IMDB_ID"] ||
                (movie["#IMDB_URL"] &&
                  movie["#IMDB_URL"].split("/title/")[1]?.split("/")[0]) ||
                null;

              // Defaults from the search hit
              const actors = movie["#ACTORS"]
                ? movie["#ACTORS"].split(", ").map((s) => s.trim())
                : [];

              let directorNames = [];
              let runtimeMinutes = "";
              let genres = [];

              // Second call: fetch details to get actual director(s), runtime, and genres
              if (imdbId) {
                try {
                  const detailsResp = await fetch(
                    `https://imdb.iamidiotareyoutoo.com/title/${imdbId}`,
                  );
                  const details = await detailsResp.json();

                  // Try several common shapes defensively
                  const fromDirectorsArr = Array.isArray(details.directors)
                    ? details.directors
                        .map((d) =>
                          typeof d === "string"
                            ? d
                            : d?.name || d?.creditName || "",
                        )
                        .filter(Boolean)
                    : [];
                  const fromCreditsArr = Array.isArray(details.credits)
                    ? details.credits
                        .filter((c) =>
                          /director/i.test(
                            (c?.job || c?.role || c?.category || "") as string,
                          ),
                        )
                        .map((c) => c?.name || c?.creditName || "")
                        .filter(Boolean)
                    : [];
                  const fromPrincipalsArr = Array.isArray(details.principals)
                    ? details.principals
                        .filter((p) =>
                          /director/i.test((p?.category || "") as string),
                        )
                        .map((p) => p?.name || p?.creditName || "")
                        .filter(Boolean)
                    : [];

                  directorNames = [
                    ...new Set([
                      ...fromDirectorsArr,
                      ...fromCreditsArr,
                      ...fromPrincipalsArr,
                    ]),
                  ];

                  runtimeMinutes =
                    typeof details.runtimeMinutes === "number"
                      ? details.runtimeMinutes
                      : typeof details.runtime === "number"
                        ? details.runtime
                        : ((details.runtimeMinutes ||
                            details.runtime ||
                            "") as string);

                  genres = Array.isArray(details.genres)
                    ? details.genres
                    : Array.isArray(details.genre)
                      ? details.genre
                      : [];
                } catch (_) {
                  // Ignore details errors; we'll fall back to search hit
                }
              }

              const length =
                typeof runtimeMinutes === "number"
                  ? `${Math.floor(runtimeMinutes / 60)}h ${runtimeMinutes % 60}m`
                  : runtimeMinutes
                    ? String(runtimeMinutes)
                    : "";

              const movieEntry = {
                type: "movie",
                title: movie["#TITLE"] || query,
                country: "", // not available in this endpoint
                year: parseInt(movie["#YEAR"]) || "",
                director:
                  directorNames.length > 0
                    ? directorNames.join(", ")
                    : movie["#AKA"] || "Unknown", // fallback if details not available
                actors,
                genre: genres, // enriched from details when possible
                length, // enriched from details when possible
                shelf: "watchlist",
                owned: false,
                rating: 0,
                watched: "",
                poster: movie["#IMG_POSTER"] || "",
                body: movie["#RANK"] ? `IMDb Rank: ${movie["#RANK"]}` : "",
              };

              // Preview uses coverUrl; mirror the key for consistency
              const capture = {
                ...movieEntry,
                coverUrl: movieEntry.poster,
              };
              showBookPreview(capture);
              status.innerText = "✓ Movie found! Confirm above.";
            } else {
              status.innerText = "❌ No movie results found.";
            }
          } else if (isSeries) {
            status.innerText = "Searching TVMaze...";
            const searchUrl = `https://api.tvmaze.com/search/shows?q=${encodeURIComponent(query)}`;
            const response = await fetch(searchUrl);
            const data = await response.json();

            if (Array.isArray(data) && data.length > 0) {
              const show = data[0]?.show || data[0];
              const year =
                show?.premiered?.slice(0, 4) || show?.ended?.slice(0, 4) || "";
              const length =
                typeof show?.runtime === "number" && show.runtime > 0
                  ? `${Math.floor(show.runtime / 60)}h ${show.runtime % 60}m`
                  : show?.runtime
                    ? String(show.runtime)
                    : "";
              // Enrich with cast and crew
              let directorNames = [];
              let actors = [];
              try {
                const detailsResp = await fetch(
                  `https://api.tvmaze.com/shows/${show.id}?embed[]=cast&embed[]=crew`,
                );
                const details = await detailsResp.json();
                const embedded = details._embedded || {};
                const crew = Array.isArray(embedded.crew) ? embedded.crew : [];
                const cast = Array.isArray(embedded.cast) ? embedded.cast : [];
                // Prefer Creators; fallback to Directors
                directorNames = crew
                  .filter((c) => /creator/i.test(String(c.type)))
                  .map((c) => c.person?.name)
                  .filter(Boolean);
                if (directorNames.length === 0) {
                  directorNames = crew
                    .filter((c) => /director/i.test(String(c.type)))
                    .map((c) => c.person?.name)
                    .filter(Boolean);
                }
                actors = cast.map((c) => c.person?.name).filter(Boolean);
              } catch (_) {
                // ignore enrichment errors
              }

              const seriesEntry = {
                type: "series",
                title: show?.name || query,
                country:
                  show?.network?.country?.name ||
                  show?.network?.country?.code ||
                  "",
                year: year,
                director: directorNames.length
                  ? directorNames.join(", ")
                  : "Unknown",
                actors,
                genre: Array.isArray(show?.genres) ? show.genres : [],
                length,
                shelf: "watchlist",
                owned: false,
                rating: 0,
                watched: "",
                poster: show?.image?.original || show?.image?.medium || "",
                body: "",
              };
              const capture = {
                ...seriesEntry,
                coverUrl: seriesEntry.poster,
              };
              showBookPreview(capture);
              status.innerText = "✓ Series found! Confirm above.";
            } else {
              status.innerText = "❌ No series results found.";
            }
          } else {
            status.innerText =
              "⚠️ Unknown route. Use /books/new, /movies/new, or /series/new.";
          }
        } catch (e) {
          console.error(e);
          status.innerText = "⚠️ Fetch Error.";
        }
      };
    </script>
  </body>
</html>
