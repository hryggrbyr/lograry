---
const title = "Admin Panel";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root {
        --color-brand-admin: hsl(25, 95%, 55%);
        --color-brand-admin-tint: hsl(25, 95%, 50%);
      }
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 2rem;
        max-width: 80rem;
        margin-inline: auto;
      }

      /* Form elements */
      input,
      select,
      textarea,
      button {
        font: inherit;
        width: 100%;
      }

      input[type="checkbox"] {
        width: auto;
      }

      textarea {
        resize: vertical;
      }

      button {
        appearance: none;
        background-color: var(--color-brand-admin);
        color: white;
        cursor: pointer;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 0.25rem;
        width: auto;
      }

      button:hover {
        background-color: var(--color-brand-admin-tint);
      }

      button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      /* Layout containers */
      section,
      aside,
      fieldset {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      fieldset {
        border: 1px solid currentColor;
        padding: 1rem;
        margin: 0;
      }

      legend {
        padding: 0 0.5rem;
      }

      form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      /* Two-column grid for main content */
      .admin-grid {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 2rem;
        align-items: start;
      }

      @media (max-width: 60rem) {
        .admin-grid {
          grid-template-columns: 1fr;
        }
      }

      /* Responsive side-by-side pattern */
      section:has(form) {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        align-items: flex-end;
      }

      section:has(form) > * {
        flex-grow: 1;
        flex-basis: calc((40rem - 100%) * 999);
      }

      /* Multi-field rows */
      div:has(> div:first-child > label) {
        display: flex;
        gap: 1rem;
        align-items: end;
      }

      div:has(> div:first-child > label) > div {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      div:has(> div:first-child > label) input[type="checkbox"] {
        margin-top: 1.5rem;
      }

      /* Field labels and inputs */
      label {
        display: block;
        margin-bottom: 0.25rem;
        font-weight: 500;
      }

      /* Dialog */
      dialog {
        border: 2px solid var(--color-brand-admin);
        border-radius: 0.5rem;
        padding: 2rem;
        max-width: 40rem;
        margin: auto;
      }

      dialog::backdrop {
        backdrop-filter: blur(4px);
        background: rgba(0, 0, 0, 0.5);
      }

      dialog > div {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      dialog button {
        margin-top: 0.5rem;
      }

      /* Selection dialog */
      #selection-dialog > div:last-child {
        flex-direction: row;
        gap: 0.5rem;
      }

      #selection-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        max-height: 60vh;
        overflow-y: auto;
      }

      #selection-list label {
        display: flex;
        gap: 0.5rem;
        padding: 0.5rem;
        border: 1px solid currentColor;
        border-radius: 0.25rem;
        cursor: pointer;
      }

      #selection-list label:has(input:checked) {
        background: var(--color-brand-admin);
        color: white;
      }

      #selection-list input[type="radio"] {
        width: auto;
        margin-top: 0.25rem;
      }

      /* Conditional visibility */
      [data-media-only] {
        display: none;
      }

      [data-selection="books"] [data-media-only="books"],
      [data-selection="movies"] [data-media-only="movies"],
      [data-selection="series"] [data-media-only="series"] {
        display: block;
      }

      /* Utility */
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
      }

      hr {
        border: none;
        border-top: 1px solid currentColor;
        margin: 2rem 0;
        opacity: 0.3;
      }
      .flow > * + * {
        margin-block-start: 1rlh;
      }
      .stacker {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .stacker > * {
        flex-grow: 1;
        flex-basis: calc((40rem - 100%) * 999);
      }
    </style>
  </head>
  <body>
    <dialog id="auth-dialog">
      <div>
        <h2>Restricted Access</h2>
        <p>
          No GitHub credentials found in local storage. Please provide
          authorization to access the archives.
        </p>
        <fieldset>
          <div>
            <label for="modal-gh-user">GitHub Username</label>
            <input type="text" id="modal-gh-user" placeholder="Username" />
          </div>
          <div>
            <label for="modal-gh-pat">Personal Access Token</label>
            <input type="text" id="modal-gh-pat" placeholder="ghp_xxxx..." />
          </div>
        </fieldset>
        <button id="btn-auth-confirm">Sign In</button>
      </div>
    </dialog>

    <div>
      <header>
        <h1>New Archive Entry</h1>
      </header>

      <section class="admin-container">
        <form id="search-form">
          <h3>Search API</h3>
          <div>
            <label for="search-query" class="visually-hidden"
              >Search query</label
            >
            <input type="text" id="search-query" placeholder="Search..." />
            <button type="submit" id="btn-search">Search</button>
          </div>
          <p id="search-status" aria-live="polite"></p>
        </form>

        <div>
          <label for="media-type">Collection Type</label>
          <select id="media-type">
            <option value="books">📚 Books</option>
            <option value="movies">🎬 Films</option>
            <option value="series">📺 TV Shows</option>
          </select>
        </div>
      </section>

      <hr />

      <div class="admin-grid">
        <section>
          <form id="entry-form">
            <div>
              <label for="field-title">Title</label>
              <input type="text" id="field-title" required />
            </div>
            <div>
              <label for="field-created">Date Created</label>
              <input type="date" id="field-created" required />
            </div>

            <div id="all-fields-container">
              <div id="fields-books" data-media-only="books">
                <div>
                  <label for="field-subtitle">Subtitle</label>
                  <input type="text" id="field-subtitle" />
                </div>

                <div>
                  <label for="field-author">Authors</label>
                  <input
                    type="text"
                    id="field-author"
                    placeholder="Comma separated..."
                  />
                </div>

                <div>
                  <label for="field-tags">Tags</label>
                  <input
                    type="text"
                    id="field-tags"
                    list="tag-suggestions"
                    placeholder="Type to search or add custom..."
                    autocomplete="off"
                  />
                  <datalist id="tag-suggestions">
                    <!-- options here -->
                  </datalist>
                </div>

                <div>
                  <div>
                    <label for="field-shelf">Shelf</label>
                    <select id="field-shelf">
                      <option value="to-read">To Read</option>
                      <option value="reading">Reading</option>
                      <option value="read">Read</option>
                      <option value="abandoned">Abandoned</option>
                    </select>
                  </div>
                  <div>
                    <label for="field-rating">Rating</label>
                    <input type="number" id="field-rating" min="0" max="5" />
                  </div>
                  <div>
                    <label for="field-owned">Owned</label>
                    <input type="checkbox" id="field-owned" />
                  </div>
                </div>

                <div>
                  <div>
                    <label for="field-start_date">Start Date</label>
                    <input type="date" id="field-start_date" />
                  </div>
                  <div>
                    <label for="field-end_date">End Date</label>
                    <input type="date" id="field-end_date" />
                  </div>
                </div>

                <div>
                  <div>
                    <label for="field-publisher">Publisher</label>
                    <input type="text" id="field-publisher" />
                  </div>
                  <div>
                    <label for="field-published">Published Date</label>
                    <input
                      type="text"
                      id="field-published"
                      placeholder="YYYY-MM-DD"
                    />
                  </div>
                </div>

                <div>
                  <label for="field-isbn">ISBN</label>
                  <input type="text" id="field-isbn" />
                </div>

                <div>
                  <label for="field-coverUrl">Cover URL</label>
                  <input type="text" id="field-coverUrl" />
                </div>

                <fieldset>
                  <legend>Recommended By</legend>
                  <div>
                    <label for="field-rec-name">Name</label>
                    <input type="text" id="field-rec-name" />
                  </div>
                  <div>
                    <label for="field-rec-url">URL</label>
                    <input type="text" id="field-rec-url" />
                  </div>
                </fieldset>
              </div>

              <div data-media-only="movies">
                <label for="field-director">Director</label>
                <input type="text" id="field-director" />
              </div>
              <div data-media-only="movies">
                <label for="field-year">Year</label>
                <input type="number" id="field-year" />
              </div>
              <div data-media-only="movies">
                <label for="field-shelf-movies">Shelf</label>
                <select id="field-shelf-movies">
                  <option value="watchlist">Watchlist</option>
                  <option value="watching">Watching</option>
                  <option value="watched">Watched</option>
                </select>
              </div>

              <div data-media-only="series">
                <label for="field-creator">Creator</label>
                <input type="text" id="field-creator" />
              </div>
              <div data-media-only="series">
                <label for="field-premiere-year">Year</label>
                <input type="number" id="field-premiere-year" />
              </div>
              <div data-media-only="series">
                <label for="field-shelf-series">Shelf</label>
                <select id="field-shelf-series">
                  <option value="watchlist">Watchlist</option>
                  <option value="watching">Watching</option>
                  <option value="watched">Watched</option>
                </select>
              </div>
            </div>

            <div>
              <label for="field-body">Notes</label>
              <textarea id="field-body" rows="8"></textarea>
            </div>

            <button type="submit">Save to GitHub</button>
          </form>
        </section>

        <aside>
          <button id="btn-logout">Sign Out</button>
        </aside>
      </div>
    </div>

    <dialog id="selection-dialog">
      <h3>Select Matching Book</h3>
      <div id="selection-list"></div>
      <div>
        <button id="btn-apply-selection">Apply Selection</button>
        <button onclick="document.getElementById('selection-dialog').close()">
          Cancel
        </button>
      </div>
    </dialog>

    <script is:inline>
      const mediaSelector = document.getElementById("media-type");
      const authDialog = document.getElementById("auth-dialog");
      const searchForm = document.getElementById("search-form");

      // Check for credentials immediately
      function checkAuth() {
        const user = localStorage.getItem("LOGRARY_USER");
        const pat = localStorage.getItem("LOGRARY_PAT");
        if (!user || !pat) {
          authDialog.showModal();
        }
      }

      document.getElementById("btn-auth-confirm").onclick = () => {
        const user = document.getElementById("modal-gh-user").value;
        const pat = document.getElementById("modal-gh-pat").value;
        if (user && pat) {
          localStorage.setItem("LOGRARY_USER", user);
          localStorage.setItem("LOGRARY_PAT", pat);
          authDialog.close();
        }
      };

      document.getElementById("btn-logout").onclick = () => {
        localStorage.removeItem("LOGRARY_USER");
        localStorage.removeItem("LOGRARY_PAT");
        location.reload();
      };

      // Toggle Field Visibility
      function updateVisibility() {
        document
          .querySelector(".admin-container")
          .setAttribute("data-selection", mediaSelector.value);
        const createdField = document.getElementById("field-created");
        if (createdField && !createdField.value) {
          createdField.value = new Date().toISOString().split("T")[0];
        }
      }

      mediaSelector.onchange = updateVisibility;
      updateVisibility();
      checkAuth();

      // Search Form Handling (Handles Enter Key)
      searchForm.onsubmit = async (e) => {
        e.preventDefault();
        const query = document.getElementById("search-query").value;
        const type = mediaSelector.value;
        const status = document.getElementById("search-status");

        if (!query) return;

        status.innerText = "Searching...";
        try {
          let data = null;
          if (type === "books") data = await fetchBook(query);
          else if (type === "movies") data = await getFullMovieData(query);
          else data = await fetchSeries(query);

          if (data) {
            status.innerText = "Match found, applying...";
            populateFields(data, type);
          }
        } catch (e) {
          status.innerText = "Error: Archive not found";
        }
      };

      async function fetchBook(query) {
        const status = document.getElementById("search-status");
        try {
          const url = `https://openlibrary.org/search.json?q=${encodeURIComponent(query)}&limit=5`;
          const response = await fetch(url);
          const data = await response.json();
          if (!data.docs || data.docs.length === 0) {
            status.innerText = "No results found";
            return null;
          }

          const results = data.docs.map((book) => ({
            title: book.title,
            subtitle: book.subtitle || "",
            author: book.author_name
              ? book.author_name.join(", ")
              : "Unknown Author",
            year: book.first_publish_year || "",
            publisher: book.publisher ? book.publisher[0] : "",
            publish_date: book.publish_date ? book.publish_date[0] : "",
            isbn: book.isbn ? book.isbn[0] : "",
            coverId: book.cover_i
              ? `https://covers.openlibrary.org/b/id/${book.cover_i}-M.jpg`
              : "",
          }));
          showBookSelectionModal(results);
          return null;
        } catch (err) {
          console.error(err);
          status.innerText = "API connection failed";
          throw err;
        }
      }

      function showBookSelectionModal(books) {
        const dialog = document.getElementById("selection-dialog");
        const list = document.getElementById("selection-list");

        list.innerHTML = books
          .map((book, index) => {
            const bookData = JSON.stringify(book).replace(/'/g, "&apos;");
            return `
                <label class="selection-item">
                  <input type="radio" name="book-choice" value='${bookData}' ${index === 0 ? "checked" : ""}>
                  <div class="item-meta">
                    <strong>${book.title}</strong><br>
                    <span>By ${book.author} (${book.year})</span>
                  </div>
                </label>
              `;
          })
          .join("");
        dialog.showModal();

        document.getElementById("btn-apply-selection").onclick = () => {
          const selected = JSON.parse(
            document.querySelector('input[name="book-choice"]:checked').value,
          );
          populateFields(selected, "books");
          dialog.close();
          document.getElementById("search-status").innerText =
            "Selection applied successfully";
        };
      }

      function populateFields(data, type) {
        document.getElementById("field-title").value = data.title;
        document.getElementById("field-created").value = new Date()
          .toISOString()
          .split("T")[0];
        if (type === "books") {
          document.getElementById("field-subtitle").value = data.subtitle || "";
          document.getElementById("field-author").value = data.author;
          document.getElementById("field-isbn").value = data.isbn || "";
          document.getElementById("field-publisher").value =
            data.publisher || "";
          document.getElementById("field-published").value =
            data.publish_date || data.year || "";
          document.getElementById("field-coverUrl").value = data.coverId || "";
        } else if (type === "movies") {
          document.getElementById("field-director").value = data.director || "";
          document.getElementById("field-year").value = data.year || "";
        } else if (type === "series") {
          document.getElementById("field-creator").value = data.director || "";
          document.getElementById("field-premiere-year").value =
            data.year || "";
        }
      }

      document.getElementById("entry-form").onsubmit = async (e) => {
        e.preventDefault();
        const status = document.getElementById("search-status");
        const submitBtn = e.target.querySelector('button[type="submit"]');
        status.innerText = "Preparing entry...";
        status.innerHTML = `<span class="loading-dots">Committing to archive...</span>`;
        submitBtn.disabled = true;
        submitBtn.style.opacity = "0.5";
        submitBtn.innerText = "Saving...";

        const type = document.getElementById("media-type").value;
        const title = document.getElementById("field-title").value;
        const getArray = (id) => {
          const val = document.getElementById(id)?.value;
          return val
            ? val
                .split(",")
                .map((t) => t.trim())
                .filter((t) => t !== "")
            : [];
        };

        let entryData = {
          type:
            type === "books" ? "book" : type === "movies" ? "movie" : "series",
          title: title,
          shelf: document.getElementById(
            type === "books" ? "field-shelf" : `field-shelf-${type}`,
          ).value,
          owned: document.getElementById("field-owned").checked,
          rating: document.getElementById("field-rating").value
            ? parseInt(document.getElementById("field-rating").value, 10)
            : null,
          body: document.getElementById("field-body").value,
        };

        if (type === "books") {
          Object.assign(entryData, {
            subtitle: document.getElementById("field-subtitle")?.value || "",
            author: getArray("field-author"),
            tags: getArray("field-tags"),
            published: document.getElementById("field-published")?.value || "",
            created: document.getElementById("field-created").value,
            publisher: document.getElementById("field-publisher")?.value || "",
            isbn: document.getElementById("field-isbn")?.value || "",
            coverUrl: document.getElementById("field-coverUrl")?.value || "",
            recommended_by: {
              name: document.getElementById("field-rec-name")?.value || "",
              url: document.getElementById("field-rec-url")?.value || "",
            },
          });
        } else {
          Object.assign(entryData, {
            director:
              document.getElementById(
                type === "movies" ? "field-director" : "field-creator",
              )?.value || "",
            year: document.getElementById(
              type === "movies" ? "field-year" : "field-premiere-year",
            )?.value
              ? parseInt(
                  document.getElementById(
                    type === "movies" ? "field-year" : "field-premiere-year",
                  ).value,
                  10,
                )
              : null,
            genre: getArray("field-tags"),
            poster: document.getElementById("field-coverUrl")?.value || "",
          });
        }

        const body = entryData.body;
        delete entryData.body;
        const fileName = `${title.toLowerCase().replace(/[^a-z0-9]/g, "-")}.md`;
        const folder = `src/content/${type}`;

        try {
          const result = await pushToGitHub(folder, fileName, entryData, body);
          status.innerHTML = `<span style="color: #2b9348; font-weight: bold;">Success! Commit SHA: ${result.content.sha.substring(0, 7)}</span>`;
          submitBtn.innerText = "Saved Successfully";
          submitBtn.style.background = "#2b9348";
          setTimeout(() => {
            location.reload();
          }, 3000);
        } catch (err) {
          status.innerHTML = `<span style="color: #ae2012;">Error: Commit failed. Check console for details.</span>`;
          submitBtn.disabled = false;
          submitBtn.style.opacity = "1";
          submitBtn.innerText = "Retry";
          console.error(err);
        }
      };

      async function pushToGitHub(folder, fileName, data, body) {
        const user = localStorage.getItem("LOGRARY_USER");
        const pat = localStorage.getItem("LOGRARY_PAT");
        const repo = "hryggrbyr/lograry";

        let yaml = "---\n";
        for (const [key, value] of Object.entries(data)) {
          if (Array.isArray(value)) {
            yaml +=
              value.length === 0
                ? `${key}: []\n`
                : `${key}:\n${value.map((v) => `  - ${v}`).join("\n")}\n`;
          } else if (typeof value === "object" && value !== null) {
            yaml += `${key}:\n  name: '${value.name || ""}'\n  url: '${value.url || ""}'\n`;
          } else if (
            typeof value === "boolean" ||
            typeof value === "number" ||
            value === null
          ) {
            yaml += `${key}: ${value}\n`;
          } else {
            const sanitizedValue = value === "" ? "''" : `"${value}"`;
            yaml += `${key}: ${sanitizedValue}\n`;
          }
        }
        yaml += "---\n\n" + body;
        const path = `${folder}/${fileName}`;
        const url = `https://api.github.com/repos/${repo}/contents/${path}`;

        let sha = null;
        try {
          const res = await fetch(url, {
            headers: { Authorization: `token ${pat}` },
          });
          if (res.ok) {
            const existing = await res.json();
            sha = existing.sha;
          }
        } catch (e) {}

        const response = await fetch(url, {
          method: "PUT",
          headers: {
            Authorization: `token ${pat}`,
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            message: `archive: add ${data.title}`,
            content: btoa(unescape(encodeURIComponent(yaml))),
            sha: sha,
          }),
        });
        if (!response.ok) throw new Error("GitHub API Response Error");
        return await response.json();
      }
    </script>
  </body>
</html>
