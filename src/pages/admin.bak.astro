---
const BASE_URL = import.meta.env.BASE_URL;
import BaseLayout from "@layouts/base.astro";
---

<BaseLayout>
  <dialog id="auth-dialog">
    <div class="index-card auth-modal flow">
      <h2>[RESTRICTED_ACCESS]</h2>
      <p>
        No GitHub credentials found in local storage. Please provide
        authorization to access the archives.
      </p>
      <div class="field">
        <label>[GH_USER]</label>
        <input
          type="text"
          id="modal-gh-user"
          class="biro-input"
          placeholder="Username"
        />
      </div>
      <div class="field">
        <label>[GH_TOKEN]</label>
        <input
          type="text"
          id="modal-gh-pat"
          class="biro-input"
          placeholder="ghp_xxxx..."
        />
      </div>
      <button id="btn-auth-confirm" class="btn-stamped"
        >INITIALIZE_SESSION</button
      >
    </div>
  </dialog>

  <div class="admin-container wrapper flow">
    <header class="page-section">
      <h1>New Archive Entry</h1>
    </header>

    <section class="stacker-half">
      <form id="search-form" class="reference-box flow">
        <h3>[API_REFERENCE_SEARCH]</h3>
        <div class="field-row-multi">
          <input
            type="text"
            id="search-query"
            class="biro-input"
            placeholder="Search..."
          />
          <button type="submit" id="btn-search" class="btn-stamped"
            >EXECUTE_FETCH</button
          >
        </div>
        <p id="search-status"></p>
      </form>

      <div class="field flow">
        <label for="media-type"><h3>[COLLECTION_TYPE]</h3></label>
        <select id="media-type" class="biro-input">
          <option value="books">📚 BOOKS</option>
          <option value="movies">🎬 FILMS</option>
          <option value="series">📺 TV SHOWS</option>
        </select>
      </div>
    </section>

    <hr />

    <div class="admin-grid">
      <section class="index-card flow">
        <form id="entry-form" class="flow">
          <div class="field">
            <label>[TITLE]</label>
            <input type="text" id="field-title" class="biro-input" required />
          </div>
          <div class="field">
            <label>[RECORD_CREATED]</label>
            <input type="date" id="field-created" class="biro-input" required />
          </div>
          <div id="all-fields-container" class="flow">
            <div id="fields-books" data-media-only="books" class="flow">
              <div class="field">
                <label>[SUBTITLE]</label>
                <input type="text" id="field-subtitle" class="biro-input" />
              </div>

              <div class="field">
                <label>[AUTHORS]</label>
                <input
                  type="text"
                  id="field-author"
                  class="biro-input"
                  placeholder="Comma separated..."
                />
              </div>

              <div class="field">
                <label>[TAGS]</label>
                <div class="datalist-wrapper">
                  <input
                    type="text"
                    id="field-tags"
                    list="tag-suggestions"
                    class="biro-input"
                    placeholder="Type to search or add custom..."
                    autocomplete="off"
                  />
                  <datalist id="tag-suggestions">
                    <option value="Addiction"></option>
                    <option value="Adventure"></option>
                    <option value="Aliens"></option>
                    <option value="AlternateHistory"></option>
                    <option value="America"></option>
                    <option value="Americana"></option>
                    <option value="Anthropology"></option>
                    <option value="Biography"></option>
                    <option value="BlackComedy"></option>
                    <option value="Bleak"></option>
                    <option value="Boys"></option>
                    <option value="BritishLiterature"></option>
                    <option value="Charming"></option>
                    <option value="Childhood"></option>
                    <option value="Classic"></option>
                    <option value="Code"></option>
                    <option value="Comedy"></option>
                    <option value="ComingOfAge"></option>
                    <option value="Crime"></option>
                    <option value="Cyberpunk"></option>
                    <option value="DarkComedy"></option>
                    <option value="DarkFantasy"></option>
                    <option value="Darkhumour"></option>
                    <option value="Demons"></option>
                    <option value="Design"></option>
                    <option value="Detective"></option>
                    <option value="Dragons"></option>
                    <option value="Drama"></option>
                    <option value="DrugSmuggling"></option>
                    <option value="Dystopia"></option>
                    <option value="England"></option>
                    <option value="Environment"></option>
                    <option value="Epic"></option>
                    <option value="Espionage"></option>
                    <option value="Family"></option>
                    <option value="Fantasy"></option>
                    <option value="Fiction"></option>
                    <option value="Folklore"></option>
                    <option value="Gentle"></option>
                    <option value="Ghosts"></option>
                    <option value="Goblins"></option>
                    <option value="HistoricalFantasy"></option>
                    <option value="HistoricalFiction"></option>
                    <option value="History"></option>
                    <option value="Horror"></option>
                    <option value="Hospital"></option>
                    <option value="Iceland"></option>
                    <option value="Ireland"></option>
                    <option value="Japan"></option>
                    <option value="JuvenileFiction"></option>
                    <option value="LGBT"></option>
                    <option value="Library"></option>
                    <option value="Magic"></option>
                    <option value="MagicalSchool"></option>
                    <option value="Medical"></option>
                    <option value="Military"></option>
                    <option value="ModernFairyTale"></option>
                    <option value="ModernFairytale"></option>
                    <option value="Music"></option>
                    <option value="Mystery"></option>
                    <option value="Mythology"></option>
                    <option value="Neurodivergent"></option>
                    <option value="Nonfiction"></option>
                    <option value="Norway"></option>
                    <option value="NovellaCollection"></option>
                    <option value="OpinionColumn"></option>
                    <option value="ParallelWorlds"></option>
                    <option value="Pirates"></option>
                    <option value="Police"></option>
                    <option value="PoliceProcedural"></option>
                    <option value="Politics"></option>
                    <option value="Postapocalyptic"></option>
                    <option value="Prison"></option>
                    <option value="Psychology"></option>
                    <option value="Publishing"></option>
                    <option value="Quest"></option>
                    <option value="Relationships"></option>
                    <option value="Religion"></option>
                    <option value="Romance"></option>
                    <option value="Romantasy"></option>
                    <option value="Satire"></option>
                    <option value="Scandinoir"></option>
                    <option value="Sci-fi"></option>
                    <option value="Science"></option>
                    <option value="Scotland"></option>
                    <option value="ScottishLiterature"></option>
                    <option value="SerialKiller"></option>
                    <option value="ShortStories"></option>
                    <option value="Software"></option>
                    <option value="Space"></option>
                    <option value="Steampunk"></option>
                    <option value="Suicide"></option>
                    <option value="Supernatural"></option>
                    <option value="Suspense"></option>
                    <option value="Sweden"></option>
                    <option value="SwordAndSorcery"></option>
                    <option value="TalkingAnimals"></option>
                    <option value="Thriller"></option>
                    <option value="TimeTravel"></option>
                    <option value="TransgressiveFiction"></option>
                    <option value="UrbanFantasy"></option>
                    <option value="Vampires"></option>
                    <option value="War"></option>
                    <option value="Werewolves"></option>
                    <option value="Witches"></option>
                    <option value="Wizards"></option>
                    <option value="WorkingClass"></option>
                    <option value="YoungAdult"></option>
                    <option value="Zombies"></option>
                  </datalist>
                </div>
              </div>

              <div class="field-row-multi">
                <div class="field">
                  <label>[SHELF]</label>
                  <select id="field-shelf" class="biro-input">
                    <option value="to-read">TO-READ</option>
                    <option value="reading">READING</option>
                    <option value="read">READ</option>
                    <option value="abandoned">ABANDONED</option>
                  </select>
                </div>
                <div class="field">
                  <label>[RATING]</label>
                  <input
                    type="number"
                    id="field-rating"
                    class="biro-input"
                    min="0"
                    max="5"
                  />
                </div>
                <div class="field">
                  <label>[OWNED]</label>
                  <input type="checkbox" id="field-owned" />
                </div>
              </div>

              <div class="field-row-multi">
                <div class="field">
                  <label>[START_DATE]</label>
                  <input type="date" id="field-start_date" class="biro-input" />
                </div>
                <div class="field">
                  <label>[END_DATE]</label>
                  <input type="date" id="field-end_date" class="biro-input" />
                </div>
              </div>

              <div class="field-row-multi">
                <div class="field">
                  <label>[PUBLISHER]</label>
                  <input type="text" id="field-publisher" class="biro-input" />
                </div>
                <div class="field">
                  <label>[PUBLISHED]</label>
                  <input
                    type="text"
                    id="field-published"
                    class="biro-input"
                    placeholder="YYYY-MM-DD"
                  />
                </div>
              </div>

              <div class="field">
                <label>[ISBN]</label>
                <input type="text" id="field-isbn" class="biro-input" />
              </div>

              <div class="field">
                <label>[COVER_URL]</label>
                <input type="text" id="field-coverUrl" class="biro-input" />
              </div>

              <div class="field-group-box">
                <span class="box-label">RECOMMENDED BY</span>
                <div class="field">
                  <label>Name</label>
                  <input type="text" id="field-rec-name" class="biro-input" />
                </div>
                <div class="field">
                  <label>URL</label>
                  <input type="text" id="field-rec-url" class="biro-input" />
                </div>
              </div>
            </div>

            <div class="field" data-media-only="movies">
              <label>[DIRECTOR]</label>
              <input type="text" id="field-director" class="biro-input" />
            </div>
            <div class="field" data-media-only="movies">
              <label>[YEAR]</label>
              <input type="number" id="field-year" class="biro-input" />
            </div>
            <div class="field" data-media-only="movies">
              <label>[SHELF]</label>
              <select id="field-shelf-movies" class="biro-input">
                <option value="watchlist">WATCHLIST</option>
                <option value="watching">WATCHING</option>
                <option value="watched">WATCHED</option>
              </select>
            </div>

            <div class="field" data-media-only="series">
              <label>[CREATOR]</label>
              <input type="text" id="field-creator" class="biro-input" />
            </div>
            <div class="field" data-media-only="series">
              <label>[YEAR]</label>
              <input
                type="number"
                id="field-premiere-year"
                class="biro-input"
              />
            </div>
            <div class="field" data-media-only="series">
              <label>[SHELF]</label>
              <select id="field-shelf-series" class="biro-input">
                <option value="watchlist">WATCHLIST</option>
                <option value="watching">WATCHING</option>
                <option value="watched">WATCHED</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label>[ANNOTATIONS]</label>
            <textarea id="field-body" class="biro-input" rows="8"></textarea>
          </div>

          <div>
            <button type="submit" class="btn-stamped">COMMIT_TO_GITHUB</button>
          </div>
        </form>
      </section>

      <aside class="sidebar flow">
        <button id="btn-logout" class="btn-stamped">RESET_CREDENTIALS</button>
      </aside>
    </div>
  </div>

  <dialog id="selection-dialog" class="index-card selection-modal">
    <h3>[SELECT_MATCHING_VOLUME]</h3>
    <div id="selection-list" class="flow"></div>
    <div>
      <button id="btn-apply-selection" class="btn-stamped">APPLY_INK</button>
      <button
        onclick="document.getElementById('selection-dialog').close()"
        class="btn-stamped">DISCARD</button
      >
    </div>
  </dialog>

  <style is:global>
    /* Stacker-half Utility (Every Layout Pattern) */
    .stacker-half {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      align-items: flex-end;
    }

    .stacker-half > * {
      flex-grow: 1;
      /* Becomes 100% width when container is < 40rem (approx 640px) */
      flex-basis: calc((40rem - 100%) * 999);
    }

    /* Ensure input row is cohesive */
    .field-row-multi {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }

    .field-row-multi input {
      flex-grow: 1;
    }
  </style>

  <script is:inline>
    const mediaSelector = document.getElementById("media-type");
    const authDialog = document.getElementById("auth-dialog");
    const searchForm = document.getElementById("search-form");

    // Check for credentials immediately
    function checkAuth() {
      const user = localStorage.getItem("LOGRARY_USER");
      const pat = localStorage.getItem("LOGRARY_PAT");
      if (!user || !pat) {
        authDialog.showModal();
      }
    }

    document.getElementById("btn-auth-confirm").onclick = () => {
      const user = document.getElementById("modal-gh-user").value;
      const pat = document.getElementById("modal-gh-pat").value;
      if (user && pat) {
        localStorage.setItem("LOGRARY_USER", user);
        localStorage.setItem("LOGRARY_PAT", pat);
        authDialog.close();
      }
    };

    document.getElementById("btn-logout").onclick = () => {
      localStorage.removeItem("LOGRARY_USER");
      localStorage.removeItem("LOGRARY_PAT");
      location.reload();
    };

    // Toggle Field Visibility
    function updateVisibility() {
      document
        .querySelector(".admin-container")
        .setAttribute("data-selection", mediaSelector.value);
      const createdField = document.getElementById("field-created");
      if (createdField && !createdField.value) {
        createdField.value = new Date().toISOString().split("T")[0];
      }
    }

    mediaSelector.onchange = updateVisibility;
    updateVisibility();
    checkAuth();

    // Search Form Handling (Handles Enter Key)
    searchForm.onsubmit = async (e) => {
      e.preventDefault();
      const query = document.getElementById("search-query").value;
      const type = mediaSelector.value;
      const status = document.getElementById("search-status");

      if (!query) return;

      status.innerText = "SEARCHING_ARCHIVES...";
      try {
        let data = null;
        if (type === "books") data = await fetchBook(query);
        else if (type === "movies") data = await getFullMovieData(query);
        else data = await fetchSeries(query);

        if (data) {
          status.innerText = "MATCH_FOUND_APPLYING_INK...";
          populateFields(data, type);
        }
      } catch (e) {
        status.innerText = "ERROR_ARCHIVE_NOT_FOUND";
      }
    };

    async function fetchBook(query) {
      const status = document.getElementById("search-status");
      try {
        const url = `https://openlibrary.org/search.json?q=${encodeURIComponent(query)}&limit=5`;
        const response = await fetch(url);
        const data = await response.json();
        if (!data.docs || data.docs.length === 0) {
          status.innerText = "ERROR_ZERO_RESULTS";
          return null;
        }

        const results = data.docs.map((book) => ({
          title: book.title,
          subtitle: book.subtitle || "",
          author: book.author_name
            ? book.author_name.join(", ")
            : "Unknown Author",
          year: book.first_publish_year || "",
          publisher: book.publisher ? book.publisher[0] : "",
          publish_date: book.publish_date ? book.publish_date[0] : "",
          isbn: book.isbn ? book.isbn[0] : "",
          coverId: book.cover_i
            ? `https://covers.openlibrary.org/b/id/${book.cover_i}-M.jpg`
            : "",
        }));
        showBookSelectionModal(results);
        return null;
      } catch (err) {
        console.error(err);
        status.innerText = "API_CONNECTION_FAILED";
        throw err;
      }
    }

    function showBookSelectionModal(books) {
      const dialog = document.getElementById("selection-dialog");
      const list = document.getElementById("selection-list");

      list.innerHTML = books
        .map((book, index) => {
          // Fix: Use double quotes for the value attribute and avoid single quote collision
          const bookData = JSON.stringify(book).replace(/'/g, "&apos;");
          return `
              <label class="selection-item">
                <input type="radio" name="book-choice" value='${bookData}' ${index === 0 ? "checked" : ""}>
                <div class="item-meta">
                  <strong>${book.title}</strong><br>
                  <span>By ${book.author} (${book.year})</span>
                </div>
              </label>
            `;
        })
        .join("");
      dialog.showModal();

      document.getElementById("btn-apply-selection").onclick = () => {
        const selected = JSON.parse(
          document.querySelector('input[name="book-choice"]:checked').value,
        );
        populateFields(selected, "books");
        dialog.close();
        document.getElementById("search-status").innerText =
          "INK_APPLIED_SUCCESSFULLY";
      };
    }

    function populateFields(data, type) {
      document.getElementById("field-title").value = data.title;
      document.getElementById("field-created").value = new Date()
        .toISOString()
        .split("T")[0];
      if (type === "books") {
        document.getElementById("field-subtitle").value = data.subtitle || "";
        document.getElementById("field-author").value = data.author;
        document.getElementById("field-isbn").value = data.isbn || "";
        document.getElementById("field-publisher").value = data.publisher || "";
        document.getElementById("field-published").value =
          data.publish_date || data.year || "";
        document.getElementById("field-coverUrl").value = data.coverId || "";
      } else if (type === "movies") {
        document.getElementById("field-director").value = data.director || "";
        document.getElementById("field-year").value = data.year || "";
      } else if (type === "series") {
        document.getElementById("field-creator").value = data.director || "";
        document.getElementById("field-premiere-year").value = data.year || "";
      }
    }

    document.getElementById("entry-form").onsubmit = async (e) => {
      e.preventDefault();
      const status = document.getElementById("search-status");
      const submitBtn = e.target.querySelector('button[type="submit"]');
      status.innerText = "PREPARING_ARCHIVE_ENTRY...";
      status.innerHTML = `<span class="loading-dots">COMMITTING_TO_ARCHIVE</span>`;
      submitBtn.disabled = true;
      submitBtn.style.opacity = "0.5";
      submitBtn.innerText = "INKING...";

      const type = document.getElementById("media-type").value;
      const title = document.getElementById("field-title").value;
      const getArray = (id) => {
        const val = document.getElementById(id)?.value;
        return val
          ? val
              .split(",")
              .map((t) => t.trim())
              .filter((t) => t !== "")
          : [];
      };

      let entryData = {
        type:
          type === "books" ? "book" : type === "movies" ? "movie" : "series",
        title: title,
        shelf: document.getElementById(
          type === "books" ? "field-shelf" : `field-shelf-${type}`,
        ).value,
        owned: document.getElementById("field-owned").checked,
        rating: document.getElementById("field-rating").value
          ? parseInt(document.getElementById("field-rating").value, 10)
          : null,
        body: document.getElementById("field-body").value,
      };

      if (type === "books") {
        Object.assign(entryData, {
          subtitle: document.getElementById("field-subtitle")?.value || "",
          author: getArray("field-author"),
          tags: getArray("field-tags"),
          published: document.getElementById("field-published")?.value || "",
          created: document.getElementById("field-created").value,
          publisher: document.getElementById("field-publisher")?.value || "",
          isbn: document.getElementById("field-isbn")?.value || "",
          coverUrl: document.getElementById("field-coverUrl")?.value || "",
          recommended_by: {
            name: document.getElementById("field-rec-name")?.value || "",
            url: document.getElementById("field-rec-url")?.value || "",
          },
        });
      } else {
        Object.assign(entryData, {
          director:
            document.getElementById(
              type === "movies" ? "field-director" : "field-creator",
            )?.value || "",
          year: document.getElementById(
            type === "movies" ? "field-year" : "field-premiere-year",
          )?.value
            ? parseInt(
                document.getElementById(
                  type === "movies" ? "field-year" : "field-premiere-year",
                ).value,
                10,
              )
            : null,
          genre: getArray("field-tags"),
          poster: document.getElementById("field-coverUrl")?.value || "",
        });
      }

      const body = entryData.body;
      delete entryData.body;
      const fileName = `${title.toLowerCase().replace(/[^a-z0-9]/g, "-")}.md`;
      const folder = `src/content/${type}`;

      try {
        const result = await pushToGitHub(folder, fileName, entryData, body);
        status.innerHTML = `<span style="color: #2b9348; font-weight: bold;">✓ COMMIT_SUCCESSFUL_SHA: ${result.content.sha.substring(0, 7)}</span>`;
        submitBtn.innerText = "STAMPED_SUCCESS";
        submitBtn.style.background = "#2b9348";
        setTimeout(() => {
          location.reload();
        }, 3000);
      } catch (err) {
        status.innerHTML = `<span style="color: #ae2012;">⚠ COMMIT_FAILED_CHECK_CONSOLE</span>`;
        submitBtn.disabled = false;
        submitBtn.style.opacity = "1";
        submitBtn.innerText = "RETRY_COMMIT";
        console.error(err);
      }
    };

    async function pushToGitHub(folder, fileName, data, body) {
      const user = localStorage.getItem("LOGRARY_USER");
      const pat = localStorage.getItem("LOGRARY_PAT");
      const repo = "hryggrbyr/lograry";

      let yaml = "---\n";
      for (const [key, value] of Object.entries(data)) {
        if (Array.isArray(value)) {
          yaml +=
            value.length === 0
              ? `${key}: []\n`
              : `${key}:\n${value.map((v) => `  - ${v}`).join("\n")}\n`;
        } else if (typeof value === "object" && value !== null) {
          yaml += `${key}:\n  name: '${value.name || ""}'\n  url: '${value.url || ""}'\n`;
        } else if (
          typeof value === "boolean" ||
          typeof value === "number" ||
          value === null
        ) {
          yaml += `${key}: ${value}\n`;
        } else {
          const sanitizedValue = value === "" ? "''" : `"${value}"`;
          yaml += `${key}: ${sanitizedValue}\n`;
        }
      }
      yaml += "---\n\n" + body;
      const path = `${folder}/${fileName}`;
      const url = `https://api.github.com/repos/${repo}/contents/${path}`;

      let sha = null;
      try {
        const res = await fetch(url, {
          headers: { Authorization: `token ${pat}` },
        });
        if (res.ok) {
          const existing = await res.json();
          sha = existing.sha;
        }
      } catch (e) {}

      const response = await fetch(url, {
        method: "PUT",
        headers: {
          Authorization: `token ${pat}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          message: `archive: add ${data.title}`,
          content: btoa(unescape(encodeURIComponent(yaml))),
          sha: sha,
        }),
      });
      if (!response.ok) throw new Error("GitHub API Response Error");
      return await response.json();
    }
  </script>
</BaseLayout>
